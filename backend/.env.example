AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=8000
PORT=5000
MONGODB_URI=mongodb://localhost:27017/livelihood_navigator
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=30d

# Optional IVR answer email notifications (use a Gmail App Password)
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-16-character-gmail-app-password
EMAIL_RECIPIENT=your-receiving-address@gmail.com
